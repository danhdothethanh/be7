@model MaSV_MyStore.Models.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-5 mb-5 text-center">
    <div class="card shadow mx-auto" style="max-width:700px;">
        <div class="card-body py-5">
            <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
            <h2 class="text-success">Đặt hàng thành công!</h2>
            <p class="lead">Cảm ơn bạn đã mua hàng tại MyStore.</p>
            
            <hr />
            <div class="text-start px-4">
                <p><strong>Mã đơn hàng:</strong> #@Model.OrderID</p>
                <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") ₫</span></p>
                <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                <p><strong>Phương thức giao hàng:</strong> @Model.DeliveryMethod</p>
                <p><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                <p><strong>Trạng thái:</strong> @Model.Status</p>
            </div>

            <h5 class="mt-4">Chi tiết đơn hàng</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>SL</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails)
                    {
                        <tr>
                            <td>@(d.Product?.ProductName ?? "N/A")</td>
                            <td>@d.Quantity</td>
                            <td>@d.UnitPrice.ToString("N0")</td>
                            <td>@((d.Quantity * d.UnitPrice).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-4">
                <a href="@Url.Action("MyOrder", "Order")" class="btn btn-primary me-2">Xem lịch sử đơn hàng</a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>
